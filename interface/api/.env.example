# Votre compte GitHub (celui qui administre cette ADA). Les nouveaux projets, eux, se créent toujours
# sur le compte de la personne connectée.
GITHUB_PROPRIETAIRE=mon-compte
# GitHub App : Settings > Developer settings > GitHub Apps > (votre App)
GITHUB_CLIENT_ID=Iv23li...
GITHUB_CLIENT_SECRET=a-remplir
# Chaîne aléatoire d'au moins 32 caractères : openssl rand -hex 32
SESSION_SECRET=a-remplir-avec-openssl-rand-hex-32
URL_INTERFACE=http://localhost:5180
PORT=3100
# Comptes GitHub autorisés (virgules). Vide : seul GITHUB_PROPRIETAIRE. Obligatoire pour une organisation.
LOGINS_AUTORISES=
# Agent de code (mode non interactif) : « claude », le chemin COMPLET d'un lanceur
# (ex. /Users/vous/.local/bin/claude-ada : « ~ » n'est pas remplacé), ou un chemin relatif à interface/api :
# ./agent-openai/runner.mjs = l'agent livré avec ADA pour une passerelle compatible OpenAI (voir son README).
# Vide = agent désactivé (ADA s'ouvre mais ne lance aucune demande).
AGENT_COMMANDE=
# Modèle de l'agent : alias (sonnet, opus, haiku) ou nom complet ; vide = modèle par défaut du compte.
AGENT_MODELE=
# Agents en même temps sur la machine (les suivants attendent leur tour)
AGENT_MAX_SIMULTANES=3
# Skills mises à disposition de l assistant (dossiers contenant un SKILL.md, séparés par des virgules).
# Par défaut (ligne absente ou commentée) : celles livrées avec ADA, dans les sous-modules git de
# skills/externes/ (dsfr-skill, bug-investigate, repo-perimetre, controle-qualite-code). Ne renseigner que pour
# les remplacer ; « AGENT_SKILLS= » (vide) retire toutes les skills.
# AGENT_SKILLS=
# Adresse des liens de démonstration ({projet} et {port} remplacés). Par défaut : http://localhost:{port}
# URL_DEMO=

# --- Mon modèle (page où chaque utilisateur renseigne SON modèle : adresse, clé, nom) ---
# Agent lancé pour ces utilisateurs (livré avec ADA, parle à une passerelle compatible OpenAI) : par défaut
# ./agent-openai/runner.mjs. Les modèles personnels sont chiffrés (clé dérivée de SESSION_SECRET) dans DOSSIER_MODELES.
# Adresses acceptées : https uniquement, jamais d'adresse locale ou interne (c'est le serveur d'ADA qui l'appelle).
# AGENT_COMMANDE_OPENAI=./agent-openai/runner.mjs
# DOSSIER_MODELES=../sessions/modeles-utilisateur
