# Compte personnel ou organisation GitHub qui possède les dépôts des POC
GITHUB_PROPRIETAIRE=mon-compte
# GitHub App : Settings > Developer settings > GitHub Apps > (votre App)
GITHUB_CLIENT_ID=Iv23li...
GITHUB_CLIENT_SECRET=a-remplir
# Chaîne aléatoire d'au moins 32 caractères : openssl rand -hex 32
SESSION_SECRET=a-remplir-avec-openssl-rand-hex-32
URL_INTERFACE=http://localhost:5180
PORT=3100
# Comptes GitHub autorisés (virgules). Vide : seul GITHUB_PROPRIETAIRE. Obligatoire pour une organisation.
LOGINS_AUTORISES=
# Agent de code (mode non interactif). Démo : exécutable Claude Code ; vide = agent désactivé.
AGENT_COMMANDE=
# Modèle de l'agent : alias (sonnet, opus, haiku) ou nom complet ; vide = modèle par défaut du compte.
AGENT_MODELE=
# Skills mises à disposition de l assistant (dossiers contenant un SKILL.md, séparés par des virgules).
# Ex. : ~/.local/share/dsfr-skill/skills/dsfr-skill (DINUM), ~/.local/share/agent-skills/skills/repo/repo-perimetre
AGENT_SKILLS=
