    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
