{
  "type": "service",
  "personnaliser": [
    "PROJET.md",
    "README.md",
    "AGENTS.md",
    "api/README.md",
    "docker-compose.yml",
    "docs/adr/0001-choix-de-la-stack.md",
    "docs/adr/README.md",
    "front/index.html",
    "front/src/App.vue",
    "front/src/views/HomeView.vue",
    "front/src/views/__tests__/HomeView.spec.ts",
    "api/.env.example",
    "helm/Chart.yaml",
    "helm/values.yaml"
  ],
  "controlesRequis": [
    "Anti-fuite (gitleaks) / Scan git history for leaked secrets",
    "Commits (Conventional Commits) / Lint commit messages",
    "Workflows (zizmor) / Audit workflows with zizmor",
    "Configuration (Trivy) / Scan config files vulnerabilities",
    "API (lint, tests, compilation)",
    "Front (lint, types, tests dont accessibilité, compilation)",
    "Image et chart (construction, helm lint)",
    "Accessibilité RGAA (pages construites)",
    "Dépendances (paquet réel, version exacte, licence)",
    "Titre de PR (Conventional Commits, semver)",
    "Taille des fichiers (une responsabilité par fichier)"
  ],
  "controles": [
    "cd /app/api && pnpm lint && pnpm test && pnpm test:e2e && pnpm build",
    "cd /app/front && pnpm lint && pnpm type-check && pnpm test:unit --run && pnpm build-only"
  ],
  "apercu": {
    "image": "node:24-bookworm",
    "base": "postgres",
    "npm": [
      "api",
      "front"
    ],
    "avant": [
      "cd /app/api && if [ -d prisma/migrations ]; then npx prisma migrate deploy; fi"
    ],
    "arrierePlan": [
      "cd /app/api && pnpm start:dev"
    ],
    "principal": "cd /app/front && npx vite --host 0.0.0.0 --port 5173 --strictPort",
    "port": 5173
  },
  "deploiement": {
    "chart": "helm"
  }
}
